[project]
name = "{{ project_name }}"
version = "0.1.0"
readme = "README.md"
requires-python = ">=3.14"
dependencies = ["djangx>={{ djangx_version }}"]

[dependency-groups]
dev = [
    "django-stubs>=6.1.2",
    "djlint>=1.49.10",
    "pre-commit>=4.7.0",
    "ramani>=0.1.0",
]

[tool.uv]
preview-features = ["format-command", "check-command"]

[tool.ruff]
exclude = ["*/migrations/*"]

[tool.djlint]
format_css = true
format_js = true
blank_line_before_tag = "block,list"
blank_line_after_tag = "endblock,endlist"
ignore = "H016,H030,H031"
